# Copy to .env and fill in real values before running docker-compose up

# First administrator. Used only when the account list is empty (first start);
# afterwards accounts live in the database and are managed in the web interface.
# With a default-looking password the account is asked to change it at first login.
AU_USERNAME=admin
AU_PASSWORD=changeme
AU_FIO=Администратор системы

# API key for machine-to-machine access to /api/v1 (header: X-API-Key).
# Optional: assigned to the first administrator at bootstrap. Later keys are
# issued per account in «Пользователи» and act on behalf of that account.
#   python -c "import secrets; print(secrets.token_hex(24))"
AU_API_KEY=

# Flask session secret — REQUIRED in production. Without it (or with this
# placeholder) the app generates a random key at startup: safe, but every
# restart logs everyone out.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Set to 1 when the app is served over HTTPS: the session cookie is then
# marked Secure and never travels over a plain connection.
AU_HTTPS=0

# Host port for the web UI (default 5000)
PORT=5000

# Largest batch a single check may receive, in megabytes (default 5120 = 5 GB).
# The browser sends the files in chunks, so this is not limited by the 600 MB
# per-request cap; the server needs free disk for the upload plus the unpacked
# PDFs. A single API request (POST /api/v1/jobs) is still capped at 600 MB.
AU_MAX_UPLOAD_MB=5120

# Where uploaded files and unpacked PDFs are staged. Empty means the system
# temp directory — check that it is on disk: if /tmp is a tmpfs, a multi-gigabyte
# batch is written straight into RAM.
AU_TMP_DIR=

# PostgreSQL. docker compose starts a `db` service from POSTGRES_* below.
# POSTGRES_PASSWORD is required: compose refuses to start without it, so no
# installation can inherit a default password.
#
# DATABASE_URL must repeat the same user/password/database — compose passes it
# through verbatim and cannot build it for you. Change the password in both
# places or the app will not connect.
#
# To run without PostgreSQL at all, blank the value:
#   DATABASE_URL=
# The app then falls back to the JSON store in memory/ (the `db` container
# still starts, it is simply unused). Moving data between the two backends is
# «Администрирование» → «Миграция базы».
POSTGRES_USER=au
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=au_reports
DATABASE_URL=postgresql://au:change-this-password@db:5432/au_reports
